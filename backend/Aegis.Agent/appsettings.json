{
  "Agent": {
    "ListenUrl": "http://127.0.0.1:8765",
    "SampleIntervalMs": 1000,
    "ProcessLimit": 50,
    "HistoryMinutes": 15,
    "DataDirectory": null,
    "AetherTimeoutSeconds": 25,
    "AuditRetentionDays": 90,
    "AuditMaxRows": 100000,
    "StateMaintenanceMinutes": 360,
    "TelemetryPersistenceSeconds": 5,
    "TelemetryRetentionHours": 24,
    "TelemetryMaxRows": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost"
}
